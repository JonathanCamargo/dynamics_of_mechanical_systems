<mujoco model="tendon_capstone">
  <!-- Tendon-pulley-lever system for capstone scenarios (NB 06, 07, 08).
       A block slides along a ceiling track; a cable routes through a fixed
       corner pulley and attaches to the tip of a wall-mounted lever.
       Impedance control of the lever angle is achieved by commanding block force.

       Conventions (consistent with pendulum.xml and planar_rr_arm.xml):
         - gravity in -Z direction, dt=0.001s
         - block: constrained to ceiling at z=1.0 by slide joint (not contact)
         - lever: hinge on right wall at x=1.0, swings in X-Z plane
         - ctrl[0] = force in N at block_slide (pulls tendon when negative)
         - ctrl[1] = torque in Nm at lever_hinge (0=passive, +/-=assisted/resisted)

       Geometry:
         - ceiling at z=1.0, floor at z=0
         - block starts at x=0.0 (center-left of ceiling)
         - corner pulley at (1.0, 0, 1.0) -- top-right corner
         - lever pivot at (1.0, 0, 0.5) -- mid-height on right wall
         - lever arm extends -0.6m in X direction (left toward room center)
  -->

  <!-- dt=0.001s matches pendulum.xml and planar_rr_arm.xml conventions -->
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <worldbody>
    <!-- Angled light to illuminate the tendon path and lever geometry -->
    <light pos="0.5 -1 2" dir="0 0.5 -1"/>

    <!-- Floor plane: visual reference for depth perception -->
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>

    <!-- Ceiling-mounted sliding block.
         The block is constrained to z=1.0 (ceiling height) by the slide joint axis,
         NOT by contact with a ceiling geom. Joint constraint enforces the rail track.
         Block body pos="0.0 0 1.0" places it at ceiling height in worldbody frame. -->
    <body name="block" pos="0.0 0 1.0">
      <!-- Slide joint: constrains motion to x-axis only (ceiling rail).
           range="-1.0 0.5": block can move 1m left (tensioning) or 0.5m right (slack).
           damping=0.5: moderate friction on the rail for numerical stability.
           armature=0.01: small reflected inertia for solver conditioning. -->
      <joint name="block_slide" type="slide" axis="1 0 0"
             range="-1.0 0.5" damping="0.5" armature="0.01"/>
      <!-- Block geom: flat box representing a slider on the ceiling rail.
           mass=0.5 kg: light enough not to dominate lever dynamics.
           rgba="0.3 0.5 0.9 1": blue color to distinguish from lever. -->
      <geom type="box" size="0.05 0.05 0.03" mass="0.5" rgba="0.3 0.5 0.9 1"/>
      <!-- block_anchor site: tendon attachment point on the block.
           pos="0 0 0" places it at the block center (block's local frame).
           This is site 1 in the cable routing: block -> corner -> lever. -->
      <site name="block_anchor" pos="0 0 0" size="0.01"/>
    </body>

    <!-- Fixed corner pulley site: attached to worldbody (does not move).
         A worldbody site is the correct representation of a fixed pulley because
         it is stationary -- it redirects the tendon path without moving itself.
         pos="1.0 0 1.0": top-right corner where horizontal ceiling rail meets right wall.
         This is site 2 in the cable routing -- the via-point that makes the L-shape.
         rgba="1 0.8 0 1": gold color for visibility of the pulley location. -->
    <site name="corner_pulley" pos="1.0 0 1.0" size="0.015" rgba="1 0.8 0 1"/>

    <!-- Wall-mounted lever body.
         pos="1.0 0 0.5": pivot on right wall (x=1.0) at mid-height (z=0.5).
         The hinge axis (Y) makes the lever swing in the X-Z plane, matching
         the cable plane of action. -->
    <body name="lever" pos="1.0 0 0.5">
      <!-- Hinge joint: lever rotates about Y-axis (swings in X-Z plane).
           range="-86 86": approximately +/-1.5 radian swing range.
           Note: MuJoCo default angle unit = degrees. The plan specified range='-1.5 1.5'
           intending radians (+/-1.5 rad = +/-85.94 deg). Using -86/86 deg as the
           equivalent in MuJoCo's default degree convention.
           damping=0.2: moderate friction so lever does not oscillate excessively.
           armature=0.005: small reflected inertia for solver stability. -->
      <joint name="lever_hinge" type="hinge" axis="0 1 0"
             range="-86 86" damping="0.2" armature="0.005"/>
      <!-- Lever arm: 0.6m capsule extending from pivot toward room center (-X).
           fromto="0 0 0 -0.6 0 0": from hinge pivot to lever tip along -X.
           mass=0.3 kg: light lever so tendon tension is the dominant force.
           rgba="0.9 0.4 0.2 1": orange color to distinguish from block. -->
      <geom type="capsule" fromto="0 0 0 -0.6 0 0"
            size="0.02" mass="0.3" rgba="0.9 0.4 0.2 1"/>
      <!-- lever_tip site: tendon attachment point at the end of the lever arm.
           pos="-0.6 0 0" matches the capsule endpoint in lever's local frame.
           This is site 3 in the cable routing (final attachment). -->
      <site name="lever_tip" pos="-0.6 0 0" size="0.01"/>
    </body>
  </worldbody>

  <tendon>
    <!-- Spatial cable tendon: routes through three sites to form an L-shaped path.
         stiffness="200": spring stiffness in N/m when tendon is stretched beyond natural length.
         width="0.005": visual width of the tendon line in the viewer.
         rgba="0.2 0.2 0.2 1": dark grey cable appearance.

         springlength="0 1.7810": tension-only deadband.
           - Lower bound = 0: cable never generates compression force.
           - Upper bound = 1.7810m: rest length (measured natural length at default config).
           - Cable generates zero force when length <= 1.7810m (slack).
           - Cable generates pulling force when length > 1.7810m (taut).
           Note: springside attribute does NOT exist in MuJoCo 3.6.0. This two-value
           springlength deadband is the verified tension-only pattern from the official
           test model (test/engine/testdata/tendon_springlength.xml).
           The upper bound "1.7810" was measured via mj_forward at the default configuration
           (block at x=0.0, lever at 0 deg). Geometry: 1.0m horizontal (block to corner) +
           0.781m diagonal (corner at (1,0,1) to lever_tip at (0.4,0,0.5)) = 1.781m. -->
    <spatial name="cable" stiffness="200" springlength="0 1.7810"
             width="0.005" rgba="0.2 0.2 0.2 1">
      <!-- Site routing order is CRITICAL -- MuJoCo routes the shortest path through these sites.
           The order MUST match the physical cable path:
             1. block_anchor: where the cable leaves the block (ceiling level)
             2. corner_pulley: the fixed corner redirect (cable changes direction 90 degrees here)
             3. lever_tip: where the cable attaches to the lever arm
           Reversing 2 and 3 would route the cable THROUGH the lever body, producing wrong forces. -->
      <site site="block_anchor"/>    <!-- 1. cable departs from block on ceiling -->
      <site site="corner_pulley"/>   <!-- 2. fixed pulley redirects cable 90 degrees at corner -->
      <site site="lever_tip"/>       <!-- 3. cable attaches to lever tip on right wall -->
    </spatial>
  </tendon>

  <actuator>
    <!-- Block motor: applies force along block_slide joint axis (x-axis).
         gear="1": ctrl[0] = force in Newtons (no gearing, consistent with prior models).
         ctrlrange="-100 100": sufficient for tendon tensions up to 100 N.
         Sign convention: axis="1 0 0" means +X is toward the corner (slack direction).
           Positive ctrl[0] pushes block right (+X, toward corner, cable SLACK).
           Negative ctrl[0] pulls block left (-X, away from corner, cable TAUT).
         Impedance controller: use NEGATIVE ctrl[0] to produce cable tension.
           Required cable tension T -> block force ctrl[0] = -T (note the sign).
         via the tendon: F_block -> T_cable -> tau_lever. -->
    <motor name="block_motor" joint="block_slide" gear="1" ctrlrange="-100 100"/>

    <!-- Hinge motor: applies torque at lever_hinge joint.
         gear="1": ctrl[1] = torque in Nm.
         ctrlrange="-10 10": range sufficient for assisted/resisted scenarios.
         Scenario usage:
           NB 06 (passive):  ctrl[1] = 0.0  (no competing torque)
           NB 07 (assisted): ctrl[1] > 0.0  (assists lever motion)
           NB 08 (resisted): ctrl[1] < 0.0  (opposes lever motion)
         Include in model but set to zero for the passive scenario. -->
    <motor name="hinge_motor" joint="lever_hinge" gear="1" ctrlrange="-10 10"/>
  </actuator>
</mujoco>
