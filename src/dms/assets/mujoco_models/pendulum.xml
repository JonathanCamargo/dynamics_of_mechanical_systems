<mujoco model="pendulum">
  <!-- Simple 1-DOF pendulum: hinge at 1m height, swings in X-Z plane.
       ctrl[0] = torque [Nm] -->

  <option timestep="0.001" gravity="0 0 -9.81"/>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>

    <body name="link" pos="0 0 1">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom name="rod" type="capsule" fromto="0 0 0 0.5 0 0"
            size="0.02" mass="0.001" rgba="0.6 0.6 0.9 1"/>
      <geom name="tip_mass" type="sphere" pos="0.5 0 0"
            size="0.05" mass="1.0" rgba="0.9 0.3 0.3 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="hinge_motor" joint="hinge" gear="1"/>
  </actuator>
</mujoco>
