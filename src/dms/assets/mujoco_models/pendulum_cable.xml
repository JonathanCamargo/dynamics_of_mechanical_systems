<mujoco model="pendulum_cable">
  <!-- Pendulum with a tension-only cable attached to a ceiling anchor via a corner redirect.
       Same pendulum geometry as pendulum.xml, plus a spatial tendon. -->

  <option timestep="0.001" gravity="0 0 -9.81"/>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>

    <!-- Fixed cable anchor and via-point above the pivot -->
    <site name="anchor" pos="0 0 1.5" size="0.02" rgba="1 0 0 1"/>
    <site name="via" pos="0.5 0 1.5" size="0.02" rgba="1 0.5 0 1"/>

    <!-- Pendulum link: hinge at 1m height, swings in X-Z plane -->
    <body name="link" pos="0 0 1">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom name="rod" type="capsule" fromto="0 0 0 0.5 0 0"
            size="0.02" mass="0.001" rgba="0.6 0.6 0.9 1"/>
      <geom name="tip_mass" type="sphere" pos="0.5 0 0"
            size="0.05" mass="1.0" rgba="0.9 0.3 0.3 1"/>
      <site name="tip" pos="0.5 0 0" size="0.02" rgba="0 0.8 0 1"/>
    </body>
  </worldbody>

  <tendon>
    <!-- Tension-only cable: anchor -> via -> tip.
         springlength deadband [0, L_natural]: zero force when slack, pulls when taut. -->
    <spatial name="cable" stiffness="100" springlength="0 1.0"
             width="0.005" rgba="0.1 0.1 0.1 1">
      <site site="anchor"/>
      <site site="via"/>
      <site site="tip"/>
    </spatial>
  </tendon>

  <actuator>
    <motor name="hinge_motor" joint="hinge" gear="1"/>
  </actuator>
</mujoco>
