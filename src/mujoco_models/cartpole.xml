<mujoco model="cart_pole">
  <option gravity="0 0 -9.81" timestep="0.002"/>
  <compiler inertiafromgeom="true"/>

  <worldbody>
    <light name="top" pos="0 0 2"/>
    <camera name="side" pos="0 -4 1" xyaxes="1 0 0 0 0.5 1"/>

    <!-- Rail (visual only, no collision) -->
    <geom name="rail" type="capsule" pos="0 0 0" quat="0.707 0 0.707 0"
          size="0.02 1.5" rgba="0.3 0.3 0.7 1" contype="0"/>

    <!-- Cart body -->
    <body name="cart" pos="0 0 0">
      <joint name="cart_slide" type="slide" axis="1 0 0" damping="0.1"/>
      <geom name="cart_geom" type="box" size="0.2 0.15 0.1"
            rgba="0.7 0.7 0 1" mass="1.0"/>

      <!-- Pole body (child of cart, pivots at cart center) -->
      <body name="pole" pos="0 0 0">
        <joint name="pole_hinge" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom name="pole_rod" type="capsule" fromto="0 0 0 0 0 -0.6"
              size="0.03" rgba="0 0.7 0.7 1" mass="0.1"/>
        <geom name="pole_mass" type="sphere" pos="0 0 -0.6"
              size="0.06" rgba="0.8 0.3 0.3 1" mass="0.1"/>
      </body>
    </body>
  </worldbody>

  <sensor>
    <jointpos name="cart_pos" joint="cart_slide"/>
    <jointpos name="pole_angle" joint="pole_hinge"/>
  </sensor>
</mujoco>
