<mujoco model="planar_arm">
  <option gravity="0 0 -9.81" timestep="0.002"/>
  <compiler inertiafromgeom="true"/>

  <worldbody>
    <light name="top" pos="0 0 2"/>
    <camera name="top_down" pos="0 0 2" xyaxes="1 0 0 0 1 0"/>

    <!-- Base (fixed to world, elevated to see arm motion) -->
    <body name="base" pos="0 0 0.5">
      <geom name="base_geom" type="cylinder" size="0.1 0.05" rgba="0.5 0.5 0.5 1"/>

      <!-- Link 1: shoulder joint (rotates in XY plane around Z axis) -->
      <body name="link1" pos="0 0 0.05">
        <joint name="shoulder" type="hinge" axis="0 0 1" damping="0.1"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0.4 0 0"
              size="0.03" rgba="0.8 0.3 0.3 1" mass="1.0"/>

        <!-- Link 2: elbow joint -->
        <body name="link2" pos="0.4 0 0">
          <joint name="elbow" type="hinge" axis="0 0 1" damping="0.1"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0.3 0 0"
                size="0.025" rgba="0.3 0.3 0.8 1" mass="0.5"/>
          <site name="end_effector" pos="0.3 0 0" size="0.02"/>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <jointpos name="shoulder_pos" joint="shoulder"/>
    <jointpos name="elbow_pos" joint="elbow"/>
    <framepos name="ee_pos" objtype="site" objname="end_effector"/>
  </sensor>
</mujoco>
