<mujoco model="simple_pendulum">
  <option gravity="0 0 -9.81" timestep="0.002"/>
  
  <worldbody>
    <light name="top" pos="0 0 2"/>
    <camera name="side" pos="0 3 0.5" xyaxes="-1 0 0 0 0 1"/>
    <body name="pendulum" pos="0 0 1">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0.1"/>
      <geom name="rod" type="capsule" fromto="0 0 0 0 0 -1" size="0.05" rgba="0.8 0.3 0.3 1"/>
      <geom name="mass" type="sphere" pos="0 0 -1" size="0.1" rgba="0.3 0.3 0.8 1"/>
    </body>
  </worldbody>

  <sensor>
    <jointpos name="theta" joint="hinge"/>
  </sensor>
</mujoco>
