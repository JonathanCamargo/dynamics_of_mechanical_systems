<mujoco model="double_pendulum">
  <option gravity="0 0 -9.81" timestep="0.002"/>
  <compiler inertiafromgeom="true"/>

  <worldbody>
    <light name="top" pos="0 0 2"/>
    <camera name="side" pos="0 -5 1" xyaxes="1 0 0 0 0.5 1"/>

    <!-- First link: attached to world -->
    <body name="link1" pos="0 0 1.5">
      <joint name="hinge1" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom name="rod1" type="capsule" fromto="0 0 0 0 0 -0.5"
            size="0.04" rgba="0.8 0.3 0.3 1" mass="1.0"/>

      <!-- Second link: attached to end of first link -->
      <body name="link2" pos="0 0 -0.5">
        <joint name="hinge2" type="hinge" axis="0 1 0" damping="0.05"/>
        <geom name="rod2" type="capsule" fromto="0 0 0 0 0 -0.5"
              size="0.04" rgba="0.3 0.3 0.8 1" mass="1.0"/>
        <site name="tip" pos="0 0 -0.5" size="0.02"/>
      </body>
    </body>
  </worldbody>

  <sensor>
    <jointpos name="theta1" joint="hinge1"/>
    <jointpos name="theta2" joint="hinge2"/>
  </sensor>
</mujoco>
